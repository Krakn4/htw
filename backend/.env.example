# Free Option 1 (Recommended): Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free Option 2: Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional Paid Option: Anthropic
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5

# Note: If all API keys above are left empty, FindIt AI automatically runs its
# built-in 100% free local OpenCV + Pillow Vision analyzer (no key required).

# Database Configuration (postgres | sqlite)
DB_MODE=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/findit
LLM_TIMEOUT_SECONDS=8
